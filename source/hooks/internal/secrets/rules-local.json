{
  "rules": [
    {
      "id": "context7-api-key",
      "regex": "\\bctx7sk[-_][A-Za-z0-9_-]{16,}",
      "entropy": 3,
      "keywords": ["ctx7sk"]
    },
    {
      "id": "figma-personal-access-token",
      "regex": "\\bfigd_[A-Za-z0-9_-]{40,200}",
      "entropy": 3,
      "keywords": ["figd_"]
    },
    {
      "id": "melious-api-key",
      "regex": "\\bsk-mel-[A-Za-z0-9_-]{40,}",
      "entropy": 3,
      "keywords": ["sk-mel-"]
    },
    {
      "id": "mistral-api-key",
      "regex": "\\bmstrl_[A-Za-z0-9_-]{20,}",
      "entropy": 3,
      "keywords": ["mstrl_"]
    },
    {
      "id": "opper-api-key",
      "regex": "\\bop-[A-Za-z0-9]{20,}\\b",
      "entropy": 3.5,
      "keywords": ["op-"]
    }
  ]
}
